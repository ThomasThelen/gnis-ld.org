extends layout.pug

block content-block
  .page-content.notfound
    h1 404
    p.notfound-lede There's nothing at this address. The identifier may be mistyped — GNIS-LD URIs never stop resolving once minted.
    .notfound-actions
      a.btn-primary(href='/search') Search for a place
      a.btn-link(href='/') Go to the homepage
    p.notfound-hint Looking for a feature? They live at #[code /lod/gnis/feature/&lt;id&gt;] — see the #[a(href='/docs#uris') URI documentation].
