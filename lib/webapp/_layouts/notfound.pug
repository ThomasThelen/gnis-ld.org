extends layout.pug

block content-block
  .page-content.notfound
    h1 404
    p.notfound-lede Oops! There's nothing at this URL. If you believe there should be, please reach out to support or file a ticket on GitHub.
    .notfound-actions
      a.btn-primary(href='/search') Search for a place
      a.btn-link(href='/') Go to the homepage
