include ../_mixins/_header
include ../_mixins/_footer

doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='description', content='GNIS-LD is the official Linked Data version of the USGS Geographic Names Information System — stable identifiers, a live SPARQL endpoint, and bulk downloads for every federally recognized place name in the United States.')
    meta(property='og:title', content='GNIS-LD')
    meta(property='og:description', content='Resolve place names to stable USGS identifiers and query authoritative geographic data as Linked Data.')
    meta(property='og:type', content='website')
    title GNIS-LD
    link(rel='icon', type='image/svg+xml', href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='%23154c79'/%3E%3Ccircle cx='8' cy='8' r='3' fill='%23fff'/%3E%3C/svg%3E")
    link(rel='stylesheet', type='text/css', href='/style/common.css')
    block content-header
  body
    +header()
    main.site-main
      block content-block
    +footer()
    script.
      (function() {
        // mark the nav link matching the current page
        var path = location.pathname;
        var links = document.querySelectorAll('.site-nav a');
        Array.prototype.forEach.call(links, function(a) {
          var href = a.getAttribute('href').split('#')[0];
          if (href === path || (href !== '/' && path.indexOf(href) === 0)) {
            a.classList.add('active');
            a.setAttribute('aria-current', 'page');
            var group = a.closest('.nav-group');
            if (group) group.querySelector('.nav-group-trigger').classList.add('active');
          }
        });
      })();
