extends layout.pug

block content-header
  link(rel='stylesheet', type='text/css', href='/style/queries.css')
  script.
    window.GNIS_BASE = "#{base_url}";
  script(src='/script/queries.js' defer)

block content-block
  .queries-page
    h1 Explore
    p.intro Explore the GNIS-LD knowledge graph visually and write SPARQL queries against it.

    .example-chips
      button.chip.active(data-example='california') Features in California
      button.chip(data-example='rainier') Mount Rainier
      button.chip(data-example='juneau') Places in Juneau
      button.chip(data-example='waterfalls') Waterfalls
      button.chip(data-example='reservoirs') Reservoirs

    details.editor-details
      summary Edit the SPARQL
      .editor-card
        textarea.query-input(spellcheck='false' aria-label='SPARQL query')
        .editor-bar
          button.run-btn#run-btn Run query
          span.hint #[kbd Ctrl]+#[kbd Enter]

    .results-card.viz-card
      .viz-bar
        span.viz-title Graph
        span.status#query-status
      .graph-area
        #graph-view
          .empty-state Loading the graph…
        aside.node-panel#node-panel(aria-hidden='true')
          .node-panel-head
            span.node-panel-title#node-panel-title
            button.node-panel-close#node-panel-close(type='button' aria-label='Close') ×
          #node-panel-body

    .results-card.table-card
      .table-bar
        span.table-title Results
        span.table-meta#table-meta
        a.download-link#download-link(hidden download='results.json') Download full response
      #table-view
        .empty-state Results will appear here.
