{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"noEmit": true
	},
	"include": ["lib/js/**/*.ts", "config.app.ts"]
}
