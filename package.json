{
  "name": "gnis-ld.org",
  "version": "1.0.0",
  "description": "Serves the USGS GNIS dataset",
  "author": {
    "name": "DataONE",
    "email": "support@dataone.org"
  },
  "keywords": [
    "usgs",
    "usgs-ld",
    "gnis",
    "gnis-ld",
    "linked-data",
    "semantic-web"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.js",
    "watch": "node scripts/build.js --watch"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.2.0",
    "@types/wellknown": "^0.5.8",
    "esbuild": "^0.25.0",
    "less": "^4.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "minimist": "^1.2.8",
    "pug": "^3.0.3",
    "wellknown": "^0.5.0"
  }
}
